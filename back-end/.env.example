# Copy to .env. Values come from `pnpm status` (local) or the Supabase dashboard (remote).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Gmail SMTP for auth OTP emails. Put these in supabase/.env (Gmail app password).
SMTP_USERNAME=
SMTP_PASSWORD=
# Google OAuth (Google Cloud Console). Put these in supabase/.env.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
