{
    "_source": "Quy tắc nghiệp vụ của Toeco. Bản nháp lấy từ features.md, tức là từ CODE. Bạn phải xác nhận từng giá trị là ý đồ sản phẩm, rồi điền _verifiedBy.",
    "_verifiedBy": "admin",
    "_verifiedAt": "2026-10-22",
    "password": {
        "minLength": 8,
        "requireLetter": false,
        "requireDigit": false,
        "allowWhitespace": false,
        "allowDiacritics": false,
        "valid": ["abcdefg1", "abcdefgh", "12345678", "Toeco2026"],
        "invalid": ["abc1234", "abcd 1234", "mậtkhẩu1", ""]
    },
    "otp": { "digits": 6, "ttlMinutes": 10 },
    "quota": {
        "guestPerDay": 33,
        "studentPerDay": 55,
        "unit": "question",
        "sharedAcrossSkills": true,
        "resetTimezone": "Asia/Ho_Chi_Minh",
        "refundOnScoringError": true
    },
    "library": {
        "pageSize": 6,
        "topics": [
            "Workplace & Office",
            "Customer Service",
            "Retail & Sales",
            "Travel & Hospitality",
            "Technology & Media",
            "Logistics & Supply",
            "Business Strategy"
        ]
    },
    "history": {
        "pageSizes": [10, 25, 50],
        "polling": { "intervalSec": 4, "maxMinutes": 3 }
    },
    "mistakes": { "windowSize": 5, "fixedAfterConsecutiveIndependent": 3 },
    "schedule": {
        "maxWeeks": 12,
        "daysPerWeek": { "min": 3, "max": 7 },
        "sessionMinutes": [30, 45, 60],
        "targetScore": { "min": 0, "max": 200, "step": 10, "optional": true }
    },
    "upload": {
        "maxInputBytes": 10485760,
        "acceptedTypes": ["image/jpeg", "image/png", "image/webp"],
        "outputType": "image/webp",
        "maxLongEdgePx": 1600,
        "maxOutputBytes": 1572864
    },
    "writing": {
        "timerWarningSec": 60,
        "wordHintQ1to5": [12, 25],
        "minWordsQ8": 300,
        "wordCountSamples": [
            { "text": "Hello,  world!", "expected": 2 },
            { "text": "e-mail", "expected": 1 },
            { "text": "", "expected": 0 },
            { "text": "   ", "expected": 0 }
        ]
    },
    "scaledScore": { "min": 0, "max": 200, "step": 10 }
}
