# Copy file này thành .env.test (KHÔNG commit .env.test).
# Lấy anon key và service_role key bằng `pnpm status` trong back-end/ sau khi chạy `pnpm start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PHẢI để TRỐNG: test không bao giờ gọi Azure/Groq/Gemini/R2 thật.
# playwright.config.ts dừng ngay nếu một key có giá trị. Khai báo rỗng để next dev không đọc key thật từ .env.local.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GROQ_API_KEY=
GEMINI_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Tài khoản test do scripts/seed-e2e.mjs tạo trên Supabase local. Chỉ dùng cho local.
E2E_STUDENT_EMAIL=student@e2e.test
